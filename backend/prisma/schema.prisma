// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String   @id @default(uuid())
  username      String   @unique
  email         String   @unique
  passwordHash  String?  // Nullable because Google OAuth users won't have a password
  googleId      String?  @unique
  createdAt     DateTime @default(now())
  
  // Relation to submissions
  submissions   SalarySubmission[]
}

model SalarySubmission {
  id                 String   @id @default(uuid())
  userId             String?  @unique // One submission per user
  role               String
  experienceYears    Float
  location           String
  salary             Float    
  salaryPeriod       String   
  companyType        String
  workMode           String   
  createdAt          DateTime @default(now())

  // Relation mapping
  user               User?    @relation(fields: [userId], references: [id])
}
